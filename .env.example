# Copiar a .env y ajustar contraseña antes de levantar los servicios
POSTGRES_DB=olist_db
POSTGRES_USER=olist_admin
POSTGRES_PASSWORD=changeme

# Estas variables las leen los contenedores jupyter y tools
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Puerto en el host para JupyterLab (8888 lo ocupa el proyecto Spark)
JUPYTER_PORT=8889

# ── Opcionales (descomentar según la máquina) ────────────────────────────────
# Si no se definen, docker-compose.yml usa los valores por defecto indicados.

# Carpeta del host con los 9 CSV de Olist (ruta absoluta, sin comillas ni espacios).
# Por defecto: ./data/raw
# DATA_DIR=/ruta/absoluta/a/olist_csv

# Carpeta del host donde se escriben las mediciones (benchmark, gráficos, planes,
# recursos, concurrencia, entorno, resultados del notebook). Ruta absoluta.
# Por defecto: ./mediciones (resultados de referencia versionados en el repo).
# Definirla para hacer corridas propias sin modificar los resultados de referencia.
# La carpeta debe existir antes de `make up`.
# MEDICIONES_DIR=/ruta/absoluta/a/mis_corridas

# Imagen de JupyterLab. Por defecto: spark-jupyter-local:latest (imagen local del autor).
# Alternativa pública multi-arch (Linux amd64 y macOS arm64):
# JUPYTER_IMAGE=quay.io/jupyter/scipy-notebook:latest

# Recursos de los contenedores. Por defecto: postgres 8g / 4 CPU, jupyter 4g / 2 CPU.
# En macOS deben caber en la memoria asignada a Docker Desktop.
# Cambiarlos afecta la comparabilidad de las mediciones de tiempo.
# PG_MEM_LIMIT=8g
# PG_CPUS=4
# JUPYTER_MEM_LIMIT=4g
# JUPYTER_CPUS=2

# ── RustFS / S3 (Etapa 2+) ──────────────────────────────────────────────────
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123

# ── Doris (Etapa 4) ──────────────────────────────────────────────────────────
# Usuario de solo lectura para Superset (se crea con make doris).
DORIS_SUPERSET_USER=superset_ro
DORIS_SUPERSET_PASS=superset_ro_pass

# ── Superset (Etapa 4) ───────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=olist-superset-secret-change-in-prod
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASS=admin
SUPERSET_ADMIN_EMAIL=admin@olist.local
SUPERSET_URL=http://localhost:8088
# Opcional: token de Mapbox para mapas deck.gl. Sin él los mapas base no cargan.
# MAPBOX_API_KEY=pk.xxxxxxxxxxxxxxxx
