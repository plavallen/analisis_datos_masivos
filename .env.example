# Copiar a .env (make lo hace solo si no existe). Los valores de ejemplo sirven tal cual
# para una instalación local; cambiar las contraseñas si se desea.

# ── PostgreSQL (Etapa 1) ─────────────────────────────────────────────────────
POSTGRES_DB=olist_db
POSTGRES_USER=olist_admin
POSTGRES_PASSWORD=changeme

# ── RustFS / S3 (lake) ───────────────────────────────────────────────────────
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123

# ── Doris ────────────────────────────────────────────────────────────────────
# Usuario de solo lectura para Superset (se crea con make doris).
DORIS_SUPERSET_USER=superset_ro
DORIS_SUPERSET_PASS=superset_ro_pass

# ── Superset ─────────────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=olist-superset-secret-change-in-prod
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASS=admin
SUPERSET_ADMIN_EMAIL=admin@olist.local
SUPERSET_URL=http://localhost:8088
# Opcional: token de Mapbox para mapas deck.gl. Sin él los mapas base no cargan.
# MAPBOX_API_KEY=pk.xxxxxxxxxxxxxxxx

# ── Opcionales ───────────────────────────────────────────────────────────────
# Límite de memoria de PostgreSQL (por defecto 4g). Debe caber en la memoria de Docker.
# PG_MEM_LIMIT=4g
