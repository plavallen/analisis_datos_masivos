# Datos originales (CSV de Kaggle): se copian a data/raw/ (la carpeta se versiona vacía)
data/*
!data/raw/
data/raw/*
!data/raw/.gitkeep

# Export del modelo entrenado (make modelo-importar) y su carpeta temporal
prediccion_export*.tar.gz
.prediccion_tmp/

# JARs de Spark (binarios grandes, se descargan con scripts/download_jars.sh)
jars/
*.jar

# Credenciales (sí se versiona .env.example)
.env
!.env.example

# Imágenes y capturas (no son código)
*.png
*.jpg
*.jpeg
*.gif
*.svg

# Datos / archivos de resultados (no son código)
*.csv
*.geojson
*.parquet
*.db

# Notebooks ejecutados (tienen outputs embedidos)
*_ejecutado*.ipynb

# Superset: solo el ZIP binario
superset/*.zip
superset/.olist_dashboard_export.zip

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Sistema operativo / editores
.DS_Store
.vscode/
.idea/
